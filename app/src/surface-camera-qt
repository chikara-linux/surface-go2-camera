#!/usr/bin/env python3
"""surface-camera — Surface Go 2 (IPU3 / libcamera) 向けカメラアプリ（Kirigami 版）

映像は appsink で NV12 を受け、QVideoFrame に包んで QML の VideoOutput に
流す。GL は意図的に使っていない（理由は start_pipeline() のコメント参照）。
撮影と QR も同じ appsink の最新サンプルから取る。

経緯の詳細は docs/investigation.md。
"""
import os
import sys
import threading
import time

import gi
gi.require_version("Gst", "1.0")
from gi.repository import Gst, GLib  # noqa: E402

from PyQt6.QtCore import (QObject, QTimer, QUrl, pyqtProperty, pyqtSignal,  # noqa: E402
                          pyqtSlot)
from PyQt6.QtCore import QSize  # noqa: E402
from PyQt6.QtGui import QGuiApplication  # noqa: E402
from PyQt6.QtMultimedia import (QVideoFrame, QVideoFrameFormat,  # noqa: E402
                                QVideoSink)
from PyQt6.QtQml import QQmlApplicationEngine  # noqa: E402

TUNING_DIR = "/usr/share/surface-camera/tuning"

# IPU3 の IPA は ExposureValue / Brightness / Gamma を実装していないため、
# libcamerasrc のそれらのプロパティは黙って無視される。明るさを変える唯一の
# 手段は AGC の目標輝度で、これはチューニングファイルにしか書けない。
# None はシステム既定（各センサーの ov5693.yaml / ov8865.yaml、target 0.40）。
BRIGHTNESS = [
    ("標準", None),
    ("控えめ", "agc-0.30.yaml"),
    ("明るい", "agc-0.50.yaml"),
    ("最大", "agc-0.60.yaml"),
]

RESOLUTIONS_FRONT = [(2560, 1920), (1920, 1440), (1280, 720)]

# リア (OV8865)。1632x1224 以下を要求すると壊れたセンサーモードが選ばれて
# 1フレーム目で停止する。3264x2448 は ImgU が受け付けない。
RESOLUTIONS_REAR = [(2560, 1920), (2048, 1536)]

# 左右反転の補正が必要なカメラ。前面は ov5693-fix でドライバ側を直してある。
MIRRORED = {"back"}


def find_cameras():
    """libcamera のカメラを列挙する。PipeWire ではなく libcamera 直結の
    プロバイダを使うので、WirePlumber で隠してある背面も見える。"""
    factory = Gst.DeviceProviderFactory.find("libcameraprovider")
    if factory is None:
        return []
    provider = factory.get()
    provider.start()
    cams = []
    for dev in provider.get_devices():
        location = "unknown"
        props = dev.get_properties()
        if props:
            text = props.to_string()
            if "CameraLocationFront" in text:
                location = "front"
            elif "CameraLocationBack" in text:
                location = "back"
        cams.append({
            "id": dev.get_display_name(),
            "location": location,
            "label": {"front": "前面", "back": "背面"}.get(location,
                                                          dev.get_display_name()),
            "resolutions": (RESOLUTIONS_REAR if location == "back"
                            else RESOLUTIONS_FRONT),
            "flip": location in MIRRORED,
        })
    provider.stop()
    # 背面を先頭にする（起動時の既定）。前面しか無ければそれが選ばれる。
    cams.sort(key=lambda c: 0 if c["location"] == "back" else 1)
    return cams


class CameraBackend(QObject):
    """カメラ制御を QML に公開する。GStreamer まわりは全てここに閉じる。"""

    toast = pyqtSignal(str)
    qrFound = pyqtSignal(str)
    # ワーカースレッドから GUI スレッドへ結果を渡す。Qt のシグナルは
    # スレッドを跨ぐと自動でキューイングされる。QTimer.singleShot は
    # イベントループを持たないスレッドからでは発火しないので使えない。
    _scanResult = pyqtSignal(str)
    stateChanged = pyqtSignal()
    shotsChanged = pyqtSignal()

    def __init__(self):
        super().__init__()
        # sink はパイプラインごとに作り直す。使い回すと古い GL コンテキストへの
        # 参照が残り、再構築時に libcamera 側のリクエスト完了処理が
        # 不正な ControlList に触れて SIGFPE で落ちる。
        self._src = None
        self._cf = None
        self._flip = None
        self._appsink = None
        self._qsink = None
        self._draw_timer = None
        self._last_sample = None
        self._frame_fmt = None
        self._frame_size = None
        self._suspended = False
        self._scanResult.connect(self._scan_done)
        self._cameras = find_cameras()
        self._cam_index = 0
        self._res_index = 0
        self._bright_index = 0
        self._shots = []
        self._pipeline = None
        self._busy = False
        self._scanning = False
        self._scan_timer = None
        self._scan_busy = False

    # ---------- QML に見せる状態 ----------

    def _cam(self):
        if not self._cameras:
            return None
        return self._cameras[self._cam_index % len(self._cameras)]

    def _resolutions(self):
        cam = self._cam()
        return cam["resolutions"] if cam else RESOLUTIONS_FRONT

    @pyqtProperty(str, notify=stateChanged)
    def cameraLabel(self):
        cam = self._cam()
        return cam["label"] if cam else "カメラなし"

    @pyqtProperty(bool, constant=True)
    def hasMultipleCameras(self):
        return len(self._cameras) > 1

    @pyqtProperty(str, notify=stateChanged)
    def resolutionLabel(self):
        w, h = self._resolutions()[self._res_index]
        return "%.1fMP  %d×%d" % (w * h / 1e6, w, h)

    @pyqtProperty(str, notify=stateChanged)
    def brightnessLabel(self):
        return "明るさ: %s" % BRIGHTNESS[self._bright_index][0]

    @pyqtProperty(bool, notify=stateChanged)
    def scanning(self):
        return self._scanning

    @pyqtProperty(list, notify=shotsChanged)
    def shots(self):
        return ["file://" + p for p in self._shots]

    @pyqtProperty(str, notify=shotsChanged)
    def lastShot(self):
        return "file://" + self._shots[-1] if self._shots else ""

    # ---------- パイプライン ----------

    def set_video_sink(self, sink):
        """QML の VideoOutput が持つ QVideoSink を受け取る。"""
        self._qsink = sink

    def start_pipeline(self):
        """パイプラインを組み直す。

        要素は毎回作り直すこと。libcamerasrc を NULL↔PLAYING で使い回すと、
        カメラを開き直した際に libgstlibcamera が停止済みのリクエストに触れ、
        assertion 'wrap->request_.get() == request' で落ちる（実測）。
        新規要素なら 12 回以上まわしても落ちない。

        あわせて GL も使わない。qml6glsink は memory:GLMemory 必須で、
        GL 経路だと今度は毎回の作り直しでコンテキストが累積し 4〜5 回で
        abort する。appsink なら通常メモリのまま扱えて両方を避けられる。
        """
        if self._suspended:
            return
        self.stop_pipeline()
        src = Gst.ElementFactory.make("libcamerasrc")
        if src is None:
            self.toast.emit("libcamerasrc がありません")
            return
        src.get_static_pad("src").set_property("stream-role", "still-capture")

        try:
            rest = Gst.parse_bin_from_description(
                "capsfilter name=cf ! videoflip name=flip ! "
                "appsink name=out caps=video/x-raw,format=NV12 "
                "max-buffers=1 drop=true sync=false", True)
        except GLib.Error as exc:
            self.toast.emit("パイプラインを作れません: %s" % exc.message)
            return

        pipeline = Gst.Pipeline.new("camera")
        pipeline.add(src)
        pipeline.add(rest)
        if not src.link(rest):
            self.toast.emit("パイプラインを接続できません")
            pipeline.set_state(Gst.State.NULL)
            return

        bus = pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self._on_gst_error)

        self._pipeline = pipeline
        self._src = src
        self._cf = rest.get_by_name("cf")
        self._flip = rest.get_by_name("flip")
        self._appsink = rest.get_by_name("out")
        self._apply_settings()
        pipeline.set_state(Gst.State.PLAYING)

        # 映像は GUI スレッドから取りに行く。スレッド跨ぎが無く、
        # UI が詰まれば自然に間引かれる。
        if self._draw_timer is None:
            self._draw_timer = QTimer()
            self._draw_timer.timeout.connect(self._draw)
        self._draw_timer.start(33)

    def _apply_settings(self):
        cam = self._cam()
        w, h = self._resolutions()[self._res_index]
        if cam:
            # camera-name はバックスラッシュを含むので parse_launch の
            # 文字列には埋め込めない。プロパティに直接設定する。
            self._src.set_property("camera-name", cam["id"])
            self._flip.set_property(
                "method", "horizontal-flip" if cam["flip"] else "none")
        self._cf.set_property("caps", Gst.Caps.from_string(
            "video/x-raw,width=%d,height=%d" % (w, h)))

    def _draw(self):
        if self._appsink is None or self._qsink is None:
            return
        sample = self._appsink.emit("try-pull-sample", 0)
        if sample is None:
            return
        self._last_sample = sample
        st = sample.get_caps().get_structure(0)
        w, h = st.get_value("width"), st.get_value("height")
        buf = sample.get_buffer()
        ok, info = buf.map(Gst.MapFlags.READ)
        if not ok:
            return
        try:
            if self._frame_size != (w, h):
                self._frame_fmt = QVideoFrameFormat(
                    QSize(w, h), QVideoFrameFormat.PixelFormat.Format_NV12)
                self._frame_size = (w, h)
            frame = QVideoFrame(self._frame_fmt)
            if not frame.map(QVideoFrame.MapMode.WriteOnly):
                return
            try:
                # NV12 は輝度面と色差面の2プレーン。行の詰め方が
                # 異なることがあるので stride を見て行単位で写す。
                data = info.data
                for plane, (rows, offset) in enumerate(
                        ((h, 0), (h // 2, w * h))):
                    stride = frame.bytesPerLine(plane)
                    dst = frame.bits(plane)
                    dst.setsize(frame.mappedBytes(plane))
                    view = memoryview(dst)
                    for y in range(rows):
                        src_off = offset + y * w
                        view[y * stride:y * stride + w] = \
                            data[src_off:src_off + w]
            finally:
                frame.unmap()
            self._qsink.setVideoFrame(frame)
        finally:
            buf.unmap(info)

    def stop_pipeline(self):
        if self._draw_timer:
            self._draw_timer.stop()
        self._last_sample = None
        if not self._pipeline:
            return
        pipeline = self._pipeline
        self._pipeline = self._src = None
        self._cf = self._flip = self._appsink = None
        pipeline.get_bus().remove_signal_watch()
        pipeline.set_state(Gst.State.NULL)
        pipeline.get_state(5 * Gst.SECOND)

    def _on_gst_error(self, _bus, msg):
        self.toast.emit("カメラのエラー: %s" % msg.parse_error()[0].message)

    # ---------- 撮影 ----------

    @pyqtSlot()
    def capture(self):
        if self._busy or self._last_sample is None:
            return
        self._busy = True
        QTimer.singleShot(0, self._grab)

    def _grab(self):
        try:
            sample = self._last_sample
            if sample is None:
                self.toast.emit("フレームを取得できませんでした")
                return
            rgb, _gray = sample_to_arrays(sample)
            if rgb is None:
                self.toast.emit("フレームを変換できませんでした")
                return
            path = save_jpeg(rgb)
            self._shots.append(path)
            self.shotsChanged.emit()
            self.toast.emit("保存: %s" % os.path.basename(path))
        finally:
            self._busy = False

    # ---------- QR 継続スキャン ----------

    @pyqtSlot()
    def toggleScan(self):
        if self._scanning:
            self._stop_scan()
        else:
            self._start_scan()

    def _start_scan(self):
        try:
            import zxingcpp  # noqa: F401
        except ImportError:
            self.toast.emit("QR デコーダがありません（python3-zxing-cpp）")
            return
        self._scanning = True
        self._scan_busy = False
        self.stateChanged.emit()
        self.toast.emit("QR を探しています… コードをカメラに向けてください")
        self._scan_timer = QTimer()
        self._scan_timer.timeout.connect(self._scan_tick)
        self._scan_timer.start(250)

    def _stop_scan(self):
        self._scanning = False
        if self._scan_timer:
            self._scan_timer.stop()
            self._scan_timer = None
        self.stateChanged.emit()

    def _scan_tick(self):
        if self._scan_busy or self._last_sample is None:
            return
        sample = self._last_sample
        # 走査中は輝度だけ取り出す。RGB 変換はここでは行わない。
        _rgb, gray = sample_to_arrays(sample, gray_only=True)
        if gray is None:
            return
        self._scan_busy = True
        threading.Thread(target=self._scan_worker, args=(gray,),
                         daemon=True).start()

    def _scan_worker(self, gray):
        """デコードは重いので別スレッドで。メインで回すと映像が固まる。"""
        text = ""
        try:
            import zxingcpp
            results = zxingcpp.read_barcodes(gray)
            text = "\n".join(r.text for r in results if r.text)
        except Exception:
            text = ""
        self._scanResult.emit(text)

    def _scan_done(self, text):
        self._scan_busy = False
        if text and self._scanning:
            self._stop_scan()
            self.qrFound.emit(text)

    # ---------- 設定の切り替え ----------

    @pyqtSlot()
    def cycleResolution(self):
        self._res_index = (self._res_index + 1) % len(self._resolutions())
        self.stateChanged.emit()
        self.start_pipeline()
        self.toast.emit("解像度を %s に変更" % self.resolutionLabel)

    @pyqtSlot()
    def switchCamera(self):
        if len(self._cameras) < 2:
            return
        if self._scanning:
            self._stop_scan()
        self._cam_index = (self._cam_index + 1) % len(self._cameras)
        self._res_index = 0
        self.stateChanged.emit()
        self.start_pipeline()
        self.toast.emit("%sカメラ" % self.cameraLabel)

    @pyqtSlot()
    def cycleBrightness(self):
        self._bright_index = (self._bright_index + 1) % len(BRIGHTNESS)
        name = BRIGHTNESS[self._bright_index][1]
        # libcamera はカメラを開くときにこの環境変数を読むので、
        # 変えたらパイプラインを作り直す必要がある。
        if name is None:
            os.environ.pop("LIBCAMERA_IPU3_TUNING_FILE", None)
        else:
            os.environ["LIBCAMERA_IPU3_TUNING_FILE"] = os.path.join(TUNING_DIR, name)
        self.stateChanged.emit()
        self.start_pipeline()
        self.toast.emit(self.brightnessLabel)

    @pyqtSlot(str)
    def openFolder(self, url):
        from PyQt6.QtGui import QDesktopServices
        path = url[7:] if url.startswith("file://") else url
        QDesktopServices.openUrl(QUrl.fromLocalFile(os.path.dirname(path)))

    @pyqtSlot(bool)
    def setActive(self, active):
        """ウィンドウが前面にあるときだけカメラを回す。
        背面に回ったらパイプラインごと止めてカメラを解放する。"""
        if active and self._suspended:
            self._suspended = False
            self.start_pipeline()
        elif not active and not self._suspended:
            self._suspended = True
            if self._scanning:
                self._stop_scan()
            self.stop_pipeline()

    @pyqtSlot()
    def shutdown(self):
        self._stop_scan()
        self.stop_pipeline()


def sample_to_arrays(sample, gray_only=False):
    """サンプルから (RGB配列, 輝度配列) を作る。NV12 と RGB 系に対応。"""
    import numpy as np
    st = sample.get_caps().get_structure(0)
    w = st.get_value("width")
    h = st.get_value("height")
    fmt = st.get_string("format")
    buf = sample.get_buffer()
    ok, info = buf.map(Gst.MapFlags.READ)
    if not ok:
        return None, None
    try:
        # 走査中は毎秒4回呼ばれる。NV12 なら輝度面だけ写せば足りるので、
        # 5MP で 7.4MB を丸ごとコピーするのは避ける。
        if gray_only and fmt == "NV12" and len(info.data) >= w * h:
            return None, np.frombuffer(
                info.data, dtype=np.uint8, count=w * h).reshape(h, w).copy()
        raw = np.frombuffer(info.data, dtype=np.uint8).copy()
    finally:
        buf.unmap(info)

    if fmt == "NV12":
        if raw.size < w * h * 3 // 2:
            return None, None
        y = raw[:w * h].reshape(h, w)
        if gray_only:
            return None, y
        uv = raw[w * h:w * h * 3 // 2].reshape(h // 2, w // 2, 2)
        yf = y.astype(np.float32)
        u = np.repeat(np.repeat(uv[:, :, 0], 2, 0), 2, 1).astype(np.float32) - 128.0
        v = np.repeat(np.repeat(uv[:, :, 1], 2, 0), 2, 1).astype(np.float32) - 128.0
        rgb = np.empty((h, w, 3), dtype=np.float32)
        rgb[:, :, 0] = yf + 1.402 * v
        rgb[:, :, 1] = yf - 0.344136 * u - 0.714136 * v
        rgb[:, :, 2] = yf + 1.772 * u
        return np.clip(rgb, 0, 255).astype(np.uint8), y.copy()

    order = {"RGBA": (0, 1, 2, 4), "RGBx": (0, 1, 2, 4),
             "BGRA": (2, 1, 0, 4), "BGRx": (2, 1, 0, 4),
             "ARGB": (1, 2, 3, 4), "xRGB": (1, 2, 3, 4),
             "RGB": (0, 1, 2, 3), "BGR": (2, 1, 0, 3)}.get(fmt)
    if order is None:
        return None, None
    r_i, g_i, b_i, stride = order
    if raw.size < w * h * stride:
        return None, None
    arr = raw[:w * h * stride].reshape(h, w, stride)
    rgb = np.stack([arr[:, :, r_i], arr[:, :, g_i], arr[:, :, b_i]], axis=2)
    gray = (0.299 * rgb[:, :, 0] + 0.587 * rgb[:, :, 1]
            + 0.114 * rgb[:, :, 2]).astype(np.uint8)
    return (None if gray_only else rgb), gray


def save_jpeg(rgb):
    from PIL import Image
    base = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) \
        or os.path.expanduser("~")
    outdir = os.path.join(base, "Camera")
    os.makedirs(outdir, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d %H-%M-%S")
    # 同じ秒に2枚撮ると上書きしてしまうので、衝突したら連番を足す。
    path = os.path.join(outdir, "Photo %s.jpg" % stamp)
    n = 1
    while os.path.exists(path):
        n += 1
        path = os.path.join(outdir, "Photo %s (%d).jpg" % (stamp, n))
    Image.fromarray(rgb).save(path, "JPEG", quality=92)
    return path


def qml_path():
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "qml", "main.qml")
    if os.path.exists(here):
        return here
    return "/usr/share/surface-camera/qml/main.qml"


def main():
    Gst.init(None)
    app = QGuiApplication(sys.argv)
    app.setApplicationName("surface-camera")
    app.setDesktopFileName("surface-camera")

    backend = CameraBackend()
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("camera", backend)
    engine.load(QUrl.fromLocalFile(qml_path()))
    if not engine.rootObjects():
        print("QML を読み込めません", file=sys.stderr)
        return 1
    root = engine.rootObjects()[0]
    out = root.findChild(QObject, "videoOut")
    if out is None:
        print("videoOut が見つかりません", file=sys.stderr)
        return 1
    backend.set_video_sink(out.property("videoSink"))
    backend.start_pipeline()

    # GStreamer のバス監視は GLib のループで回る。Qt のループから回す。
    ctx = GLib.MainContext.default()
    pump = QTimer()
    pump.timeout.connect(lambda: [ctx.iteration(False) for _ in range(3)])
    pump.start(20)

    app.aboutToQuit.connect(backend.shutdown)
    rc = app.exec()

    pump.stop()
    backend.shutdown()
    # ここで main() から戻るとローカル (app / engine / pipeline) が破棄され、
    # PyGObject と PyQt6 の解放順序が衝突して segfault する。
    # 自前の後片付けは済んでいるので、参照を保ったまま打ち切る。
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(rc)


if __name__ == "__main__":
    sys.exit(main())
