+// Log without touching the host process's syslog identity.
+//
+// openlog() is process-wide. Calling it from a PAM module renames every later
+// syslog line of the host: after a face login, sudo's own audit line
+// ("chikara : TTY=... COMMAND=...") was logged as pam_howdy[pid] instead of
+// sudo[pid], hiding it from anyone looking for sudo. Prefix the module name
+// and pass the facility explicitly instead, as pam_syslog() does.
+static void howdy_log(int priority, const char *format, ...)
+    __attribute__((format(printf, 2, 3)));
+
+static void howdy_log(int priority, const char *format, ...) {
+  char message[512];
+  va_list args;
+  va_start(args, format);
+  vsnprintf(message, sizeof(message), format, args);
+  va_end(args);
+  syslog(LOG_AUTHPRIV | priority, "pam_howdy: %s", message);
+}
