+
+	best_similarity は「顔を検出して照合した」ときにのみ更新されるため、
+	0 のままなら顔が見つからなかったということ。その場合は通知しない
+	（最初から PIN で解除するつもりのときに通知が出るのを避ける）。
+
+	PAM 経由では環境変数が絞られるので、セッションバスの位置を明示する。
+	"""
+	if not best:
+		return
+	try:
+		env = dict(os.environ)
+		env.setdefault("DBUS_SESSION_BUS_ADDRESS",
+			"unix:path=/run/user/%d/bus" % os.getuid())
+		subprocess.Popen([
+			"/usr/bin/notify-send",
+			"-a", "\u9854\u8a8d\u8a3c",
+			"-i", "face-smile",
+			"-t", "5000",
+			"\u9854\u3092\u8a8d\u8b58\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f",
+			"PIN \u3067\u89e3\u9664\u3057\u3066\u304f\u3060\u3055\u3044",
+		], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+	except Exception:
+		pass
+
