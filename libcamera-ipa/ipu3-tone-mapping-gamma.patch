 /**
+ * \brief Read the gamma value from the tuning data
+ * \param[in] context The shared IPA context
+ * \param[in] tuningData The YamlObject containing the ToneMapping tuning data
+ *
+ * The key is "gamma", the same one the libipa Gamma helper reads in later
+ * libcamera releases, so a tuning file written for this keeps working there.
+ * Without the key the previous hardcoded value of 1.1 is used.
+ *
+ * \return 0
+ */
+int ToneMapping::init([[maybe_unused]] IPAContext &context,
+		      const YamlObject &tuningData)
+{
+	double gamma = tuningData["gamma"].get<double>(1.1);
+
+	defaultGamma_ = gamma > 0.0 ? gamma : 1.1;
+
+	return 0;
+}
